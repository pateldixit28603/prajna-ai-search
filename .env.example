# ---- NVIDIA (get a free key at https://build.nvidia.com -> "Get API Key", starts with nvapi-) ----
NVIDIA_API_KEY=

# Hosted models get retired over time: run `python -m scripts.nim_check` to see what your key can use.
# Answer model + fast helper model (any chat model from the NVIDIA API catalog works)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b

# NeMo Retriever embeddings + reranker
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3_5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b

# ---- Retrieval tuning ----
MAX_SOURCES=8
PER_SOURCE_LIMIT=6
USE_QUERY_REWRITE=true
USE_DENSE=true
USE_RERANK=true

# ---- Misc ----
# Sent in the User-Agent to Wikipedia/OpenAlex (their polite-use policies ask for a contact)
CONTACT_EMAIL=you@example.com
CORS_ORIGINS=http://localhost:5173
