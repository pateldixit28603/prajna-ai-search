# ---- NVIDIA (get a free key at https://build.nvidia.com -> "Get API Key", starts with nvapi-) ----
NVIDIA_API_KEY=

# Answer model + fast helper model (any chat model from the NVIDIA API catalog works)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
LLM_FAST_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# NeMo Retriever embeddings + reranker
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-3_2-nv-rerankqa-1b-v2/reranking
RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# ---- Retrieval tuning ----
MAX_SOURCES=8
PER_SOURCE_LIMIT=6
USE_QUERY_REWRITE=true
USE_DENSE=true
USE_RERANK=true

# ---- Misc ----
# Sent in the User-Agent to Wikipedia/OpenAlex (their polite-use policies ask for a contact)
CONTACT_EMAIL=you@example.com
CORS_ORIGINS=http://localhost:5173
